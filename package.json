{
  "name": "quadro",
  "version": "0.0.0",
  "private": true,
  "description": "Türkçe günlük gruplama bulmacası — 16 kelime, 4 gizli bağ, 4 hata hakkı.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
