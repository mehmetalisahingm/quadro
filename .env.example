# Public browser configuration. Safe to expose; RLS still controls data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only master key. Never prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SECRET_KEY=

# Canonical site URL used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog EU ürün analitiği. Yalnız kullanıcı çerez şeridinde "Kabul et" dedikten sonra yüklenir.
# Proje anahtarı herkese açık bir istemci anahtarıdır (phc_...); yine de değer commit edilmez.
NEXT_PUBLIC_POSTHOG_KEY=
# Boş bırakılırsa https://eu.i.posthog.com kullanılır.
NEXT_PUBLIC_POSTHOG_HOST=
